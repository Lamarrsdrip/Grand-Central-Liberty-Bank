# Canonical application URL (no trailing slash)
APP_URL=https://bank.example.com

# MongoDB Atlas or another replica-set deployment (transactions are required).
# PRISMA_DATABASE_URL is canonical. Do not set competing aliases to other databases.
PRISMA_DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
# DB_NAME=grand_central_liberty_bank

# Generate independent random values: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Generate exactly 32 bytes encoded as base64: openssl rand -base64 32
SETTINGS_MASTER_KEY=replace-with-base64-encoded-32-byte-key

# Recommended transactional provider
RESEND_API_KEY=re_replace_with_provider_key
EMAIL_FROM=Grand Central Liberty Bank <notifications@bank.example.com>
SUPPORT_EMAIL=support@bank.example.com

# SMTP fallback (omit when using Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notifications@bank.example.com
# SMTP_PASS=replace-with-provider-password
# SMTP_SENDER_NAME=Grand Central Liberty Bank

# Optional S3-compatible protected document storage
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=bank-documents
# S3_ACCESS_KEY_ID=replace-with-access-key
# S3_SECRET_ACCESS_KEY=replace-with-secret-key
# S3_PUBLIC_BASE_URL=https://assets.bank.example.com

# Explicit development/bootstrap seed only; never configure these for normal startup.
# SEED_ADMIN_EMAIL=operations@bank.example.com
# SEED_ADMIN_PASSWORD=replace-with-one-time-strong-password
# SEED_USER_EMAIL=customer@bank.example.com
# SEED_USER_PASSWORD=replace-with-one-time-strong-password
